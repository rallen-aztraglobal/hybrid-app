<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <!-- FCM 推送：Android 13+（API 33+）需运行时动态申请；minSdk 29 需声明后才可在 33+ 动态申请 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- 设备信息采集（GAID）：Android 13+（API 33+）起需显式声明该权限，否则 GAID 恒为全零 -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID"/>
    <!-- 华为 AppGallery 安装来源：Adjust 的 huawei-referrer 插件读
         content://com.huawei.appmarket.commondata/item/5 拿 referrer。targetSdk 30+ 的包可见性
         限制下必须显式声明该 provider，否则 resolveContentProvider 返回 null，华为包的安装
         归因会全部落成自然量。非华为设备上该 provider 不存在，声明本身无副作用。 -->
    <uses-permission android:name="com.huawei.appmarket.service.commondata.permission.GET_COMMON_DATA"/>
    <queries>
        <provider android:authorities="com.huawei.appmarket.commondata" />
    </queries>
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Splash"
        tools:replace="android:dataExtractionRules,android:fullBackupContent">
        <meta-data
            android:name="com.appsflyer.devkey"
            android:value="fXoKsKQwxPCRdhD8CD8q6F" />
        <!-- AppsFlyer 广播接收器 -->
        <receiver android:name="com.appsflyer.SingleInstallBroadcastReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.android.vending.INSTALL_REFERRER"/>
            </intent-filter>
        </receiver>
        <!-- FCM 推送接收服务（见 com.hybrid.android.push.HybridMessagingService）。
             exported=false：系统通过 intent-filter 分发，无需外部可直接启动。
             无 google-services.json 时 Firebase 未初始化，onNewToken/onMessageReceived 均为 no-op。 -->
        <service
            android:name=".push.HybridMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- WebView 页面 -->
        <activity
            android:name=".WebViewActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.WebView"
        >

            <!-- ✅ 桌面图标入口 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- ✅ deeplink 入口（scheme 按大渠道注入：bp=bingo, ap/gp=gzone） -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${deeplinkScheme}" />
            </intent-filter>

        </activity>
    </application>

</manifest>