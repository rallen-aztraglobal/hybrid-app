# ============================================================================
# deploy/.env.allinone.example —— 单机合并部署（A+B 同机）
# 用法：cp .env.allinone.example .env && 改 DOMAIN（填本机 IP）等
#   docker compose -f docker-compose.allinone.yml pull && docker compose -f docker-compose.allinone.yml up -d
# 注意：本方案【无 API_BASE_URL】——go-api 在同机内网，地址固定 go-api:8090。
# ============================================================================

# 镜像版本（我方私有 registry 的 tag；或离线 load 后用 :v1.0.0）
TAG=v1.0.0

# 对外端口（当前 HTTP/IP；80 已在该机放行）
HTTP_PORT=80

# 本机对外地址：暂无域名 → 直接填【公网 IP】（如 47.80.75.106）。
# 有域名后：改成域名，并按 docs/admin/05 启用 443 TLS（挂 ./certs）。
DOMAIN=47.80.75.106

# ---- MySQL 8 ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=hybrid_admin
MYSQL_USER=hybrid
MYSQL_PASSWORD=change-me-app
DB_AUTOMIGRATE=true
DB_AUTOSEED=true            # 首启自动导入 80 渠道 + 图标/启动页/res.zip

# ---- 对象存储（图标/资源；本地磁盘）----
STORAGE_KIND=local
STORAGE_PUBLIC_URL=/static

# ---- APK 运行时域名配置端点（改域名不重打包的关键）----
# 烧进每个 APK 的 bootstrap.json；APK 启动请求 ${base}?appId=<applicationId> 拿 web 域名列表。
# 形如 https://api.<你的域名>/api/app/config。留空则 APK 拉不到实时配置、只用编译期兜底域名。
APP_CONFIG_BASE_URL=https://api.fortunegems-jackpot.online/api/app/config

# ---- JWT / 初始管理员 ----
JWT_SECRET=                 # 留空首启随机生成（重启失效）；要重启后不掉登录就填长随机串
JWT_ISSUER=hybrid-admin
BOOTSTRAP_ADMIN=admin:change-me-admin-pass    # 首登强制改密；HTTP 明文期务必尽快改

# ---- 构建机长期令牌（go-api 与 build-runner 共用，单机自动一致）----
RUNNER_TOKEN=change-me-runner-token

# ---- 构建源码来源 ----
# 留空 = 已把仓库 checkout 挂进 repo 卷；否则填 git 地址让 runner 自行 clone。
BUILDER_REPO_URL=
BUILDER_REPO_BRANCH=main

# ---- 推送（FCM）----
# 开关默认在 compose 里已为 true，这里仅在需要【关闭】或临时停发时显式覆盖。
# 私钥不在 .env：service account JSON 放 deploy/google-services/，由 compose 只读挂载进容器。
# PUSH_ENABLED=false        # 临时全局停发（保留草稿/历史）
# PUSH_CRON_ENABLE=false    # 仅停「定时发送」扫描，即时发送仍可用
