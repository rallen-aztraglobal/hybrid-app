# ============================================================================
# deploy/.env.release —— 发版脚本 release.sh 的配置（gitignored）
# 用法：cp .env.release.example .env.release 并填写真实值。
# ============================================================================

# 目标服务器（SSH）
BOX_HOST=47.80.75.106
BOX_USER=root
SSH_KEY=deploy/certs/hybrid_channel_console.pem
REMOTE_DIR=/opt/hybrid

# 构建机签名口令（烧入 build-runner 镜像；与 deploy/secrets/release.keystore 对应）
KEYSTORE_PASSWORD=your-keystore-password
KEY_ALIAS=your-key-alias
KEY_PASSWORD=your-key-password

# 商店老 key（empty-app，ADR-0016）：ap01018~ap01022、gzmkt031 等已上架渠道当年用它签名，商店绑定证书不能变。
# keystore 本体放 deploy/secrets/store-emptyapp.keystore（gitignore；可 git show ap_xiaomi:app/gzmkt031-key.jks 导出）。
STORE_EMPTYAPP_KEYSTORE_PASSWORD=
STORE_EMPTYAPP_KEY_ALIAS=my-key-alias
STORE_EMPTYAPP_KEY_PASSWORD=
