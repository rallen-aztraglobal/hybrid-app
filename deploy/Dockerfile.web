# ============================================================================
# deploy/Dockerfile.web —— 前端 dist + 两套对外 nginx（多 target）
#   决策：ADR-0008（两套独立部署）/ ADR-0010（预构建镜像）。
#
# 多阶段 + 多 target：一份 Dockerfile 产出三种镜像，由 compose 的 build.target 选：
#   build         node 编译 web/dist（中间阶段，不单独发布）。
#   web-dist      服务 B 内部 web：nginx:alpine 只出 React dist（监听内网 :80）。
#   nginx-console 服务 B 前置 nginx：TLS + / → web、/api → 服务 A、/apks/ → 产物卷。
#   nginx-api     服务 A 对外 nginx：TLS + /api、/healthz、/static、/swagger → go-api。
#
# 两个 nginx target 基于官方 nginx:alpine，用其 /etc/nginx/templates/*.template
#   + 启动期 envsubst 机制注入 ${DOMAIN}/${API_BASE_URL}（见各 .template 头注）。
# 构建上下文 = 仓库根（compose 里 context: ..）。
#
# 单独构建（自测，可选）：
#   docker build -f deploy/Dockerfile.web --target web-dist      -t hybrid-web .
#   docker build -f deploy/Dockerfile.web --target nginx-console -t hybrid-nginx-console .
#   docker build -f deploy/Dockerfile.web --target nginx-api     -t hybrid-nginx-api .
# ============================================================================

# ---- 构建阶段：编译前端 ----
FROM node:22-bookworm AS build
WORKDIR /web
# 用 pnpm（仓库 packageManager 锁定 pnpm@9）。
RUN corepack enable

# 先装依赖（命中缓存）。
COPY web/package.json web/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# 再拷源码构建。生产前端通过前置 nginx 同源反代 /api，无需 VITE_API_PROXY。
COPY web/ ./
RUN pnpm build

# ---- target: web-dist —— 服务 B 内部 web，只出 dist ----
FROM nginx:1.27-alpine AS web-dist
COPY deploy/nginx.web.conf /etc/nginx/conf.d/default.conf
RUN rm -f /usr/share/nginx/html/index.html
COPY --from=build /web/dist /usr/share/nginx/html
EXPOSE 80

# ---- target: nginx-console —— 服务 B 前置代理（/ → web、/api → A、/apks/ → 卷）----
FROM nginx:1.27-alpine AS nginx-console
# 官方镜像启动期把 templates/*.template 经 envsubst 渲染到 conf.d/（去掉 .template 后缀）。
COPY deploy/nginx.console.conf.template /etc/nginx/templates/default.conf.template
RUN rm -f /etc/nginx/conf.d/default.conf
EXPOSE 80 443
# /etc/nginx/certs 与 /srv/apks 由 compose 挂载（证书 ./certs、产物卷只读）。

# ---- target: nginx-api —— 服务 A 对外 nginx（TLS + 反代 go-api）----
FROM nginx:1.27-alpine AS nginx-api
COPY deploy/nginx.api.conf.template /etc/nginx/templates/default.conf.template
RUN rm -f /etc/nginx/conf.d/default.conf
EXPOSE 80 443
# /etc/nginx/certs 由 compose 挂载（证书 ./certs）。
