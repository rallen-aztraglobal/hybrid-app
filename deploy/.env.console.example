# ============================================================================
# deploy/.env.console.example —— 服务 B「Console + 打包」(4C8G·运营)
# 用法（在 Console 主机）：cp .env.console.example .env && 改 DOMAIN / API_BASE_URL
#   docker compose -f docker-compose.console.yml pull && docker compose -f docker-compose.console.yml up -d
# keystore 已【烧进 build-runner 镜像】（ADR-0008/0010 + docs/admin/06 §4），此处无需 keystore 配置。
# ============================================================================

# 镜像版本（我方私有 registry 的 tag）
TAG=v1.0.0

# 对外端口（nginx）
HTTP_PORT=80
HTTPS_PORT=443

# 本服务（Console 后台）对外域名——必填
DOMAIN=console.example.com

# 指向服务 A 的地址：前端 /api 反代目标 + build-runner 领任务——必填
API_BASE_URL=https://api.example.com

# build-runner 访问后端 build-job 队列的长期令牌（ADR-0008/S1）。
# 【必须与服务 A 的 RUNNER_TOKEN 完全一致】——后端按此静态令牌放行机器接口。
HYBRID_RUNNER_TOKEN=change-me-runner-token

# 构建源码来源：留空 = 已把仓库 checkout 挂进 repo 卷；否则填 git 地址让 runner clone
BUILDER_REPO_URL=
BUILDER_REPO_BRANCH=main
