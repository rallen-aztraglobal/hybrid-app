# ============================================================================
# deploy/nginx.console.conf.template —— 服务 B「Console+打包」前置 nginx
#   决策：ADR-0008（服务 B = nginx + web + build-runner）/ docs/admin/05。
#
#   :443 TLS 终结（证书来自 ./certs，运维放 fullchain.pem / privkey.pem）。
#   :80  整站 301 跳 https。
#   /       → web（React 静态 dist，内部 upstream）。
#   /api    → 反代到服务 A（${API_BASE_URL}，跨主机 / HTTPS）。
#   /apks/  → 静态产物卷（与 build-runner 共享，供下载；ADR-0008：APK 不走 CDN）。
#
# ${DOMAIN} / ${API_BASE_URL} 由 compose 注入，官方 nginx 镜像启动期 envsubst
#   渲染本模板 → /etc/nginx/conf.d/default.conf。${API_BASE_URL} 被替换成字面量
#   （含 scheme），故 proxy_pass 无需运行时 resolver。nginx 运行时变量（$host 等）保留。
# ============================================================================

upstream web_dist {
    server web:80;
    keepalive 16;
}

# HTTP → HTTPS 跳转。
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};
    server_tokens off;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    server_tokens off;
    client_max_body_size 32m;
    sendfile on;
    tcp_nopush on;
    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;
    gzip_min_length 1024;

    # ---- /api → 反代到服务 A（跨主机；${API_BASE_URL} 含 scheme）----
    location /api/ {
        proxy_pass            ${API_BASE_URL};
        proxy_http_version    1.1;
        proxy_set_header      Host              $proxy_host;   # 跨主机：用上游主机名做 Host/SNI。
        proxy_set_header      X-Real-IP         $remote_addr;
        proxy_set_header      X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header      X-Forwarded-Proto $scheme;
        proxy_set_header      Connection        "";
        proxy_ssl_server_name on;                              # HTTPS 上游需 SNI。
        proxy_read_timeout    120s;                            # 打包触发等接口可能稍慢。
    }

    # ---- 构建产物下载：/apks/<brand>/<flavor>/<versionName>/app-*.apk ----
    # 直接由 nginx 从共享产物卷出静态文件（ADR-0008：APK 不走 MinIO/CDN）。
    location /apks/ {
        alias /srv/apks/;
        autoindex off;                    # 不暴露目录列表；下载靠 build_record.apk_urls。
        types { application/vnd.android.package-archive apk; }
        default_type application/octet-stream;
        add_header Content-Disposition "attachment";
        add_header Cache-Control "public, max-age=300";
    }

    # ---- 其余全部交给内部 web（React 静态 dist + SPA 回退）----
    location / {
        proxy_pass         http://web_dist;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Connection        "";
    }
}
