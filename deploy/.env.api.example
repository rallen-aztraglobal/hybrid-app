# ============================================================================
# deploy/.env.api.example —— 服务 A「API 服务」(1C2G·公网)
# 用法（在 API 主机）：cp .env.api.example .env && 改 DOMAIN 等
#   docker compose -f docker-compose.api.yml pull && docker compose -f docker-compose.api.yml up -d
# 安全：勿填真实口令到 *.example；deploy/.env 含口令务必 gitignore，勿提交。
# ============================================================================

# 镜像版本（我方私有 registry 的 tag；运维 pull，不 build）
TAG=v1.0.0

# 对外端口（nginx）
HTTP_PORT=80
HTTPS_PORT=443

# 本服务对外域名（APK 拉配置 + 后台数据 API）——必填
DOMAIN=api.example.com

# 前端跨域来源：Console 独立域名时填其来源；与 Console 同源反代则留空
CORS_ALLOW_ORIGIN=https://console.example.com

# ---- MySQL 8 ----
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=hybrid_admin
MYSQL_USER=hybrid
MYSQL_PASSWORD=change-me-app
DB_AUTOMIGRATE=true          # 首启 true 建表；稳定后建议 false + golang-migrate
DB_AUTOSEED=true             # 首启建 3 个品牌 + 应用商店 + bootstrap admin 账号 + 导入 channels/*.csv。
                              # 注意：RBAC 基础数据（3 个内置角色 + 存量账号 role_id 回填）不受此开关影响，
                              # 无论 true/false 每次启动都会无条件幂等执行（否则关掉此开关会导致角色表
                              # 为空、全站鉴权 401 且无法自愈，见 docs/admin/10-rbac.md）。

# ---- 对象存储（图标/资源；APK 不走这里，见 ADR-0008）----
STORAGE_KIND=local           # local 单机最简；或 minio
STORAGE_PUBLIC_URL=/static

# ---- JWT / 初始管理员 ----
JWT_SECRET=change-me-to-a-long-random-secret   # 必填，生产务必长随机串
JWT_ISSUER=hybrid-admin
BOOTSTRAP_ADMIN=admin:change-me-admin-pass      # 首启无用户时建此 admin，首登后改密
RUNNER_TOKEN=change-me-shared-with-console       # 构建机长期令牌（ADR-0008/S1），须与服务 B 的 HYBRID_RUNNER_TOKEN 完全一致

# ---- 运行时配置端点 / 域名巡检 ----
APP_PROBE_PATH=/healthz
APP_CONFIG_TTL_SECONDS=600
DOMAIN_PROBE_ENABLE=true
# APK 运行时配置端点基址（烧进 bootstrap.json 的 configUrl）；形如 https://api.<域名>/api/app/config
APP_CONFIG_BASE_URL=
