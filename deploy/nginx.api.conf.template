# ============================================================================
# deploy/nginx.api.conf.template —— 服务 A「API 服务」对外 nginx（TLS + 反代）
#   决策：ADR-0008（服务 A = go-api + mysql + 自己的 nginx）/ docs/admin/05。
#
#   :443 TLS 终结（证书来自 ./certs，运维放 fullchain.pem / privkey.pem）。
#   :80  整站 301 跳 https。
#   /api、/healthz、/static、/swagger → go-api:8090。
#   不含 /apks/——APK 下载在服务 B（Console）。
#
# ${DOMAIN} 由 compose 注入，官方 nginx 镜像启动期 envsubst 渲染本模板
#   → /etc/nginx/conf.d/default.conf。nginx 运行时变量（$host 等）保持不被替换。
# ============================================================================

upstream go_api {
    server go-api:8090;
    keepalive 32;
}

# HTTP → HTTPS 跳转。
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};
    server_tokens off;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    server_tokens off;
    client_max_body_size 32m;          # 图标主图 / 资源上传足够。
    sendfile on;
    tcp_nopush on;
    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/xml image/svg+xml;
    gzip_min_length 1024;

    # ---- API 反代到后端 :8090（含公开 /api/app/config?appId=）----
    location /api/ {
        proxy_pass         http://go_api;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_set_header   Connection        "";
        proxy_read_timeout 120s;
    }

    # 后端健康端点（APK 容灾探针校验「确实是我们站点」，ADR-0003）。
    location = /healthz {
        proxy_pass         http://go_api;
        proxy_set_header   Host $host;
        access_log         off;
    }

    # OpenAPI UI / spec（供前端生成客户端）。
    location /swagger/ {
        proxy_pass         http://go_api;
        proxy_set_header   Host $host;
    }

    # 后端本地对象存储（图标 / 资源 zip），STORAGE_KIND=local 时启用。
    location /static/ {
        proxy_pass         http://go_api;
        proxy_set_header   Host $host;
    }
}
